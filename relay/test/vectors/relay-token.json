      "route": "hello",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 2
      }
     },
     "expect": {
      "status": 200
     }
    },
    {
     "request": {
      "route": "login-nonce",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 1
      },
      "body": {
       "$dev": "alice"
      }
     },
     "expect": {
      "status": 200,
      "json": {
       "nonce": "$any",
       "gen": 3,
       "expires": {
        "$time": 120000
       }
      }
     }
    },
    {
     "request": {
      "route": "login",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 1
      },
      "body": {
       "$login": {
        "dev": "alice",
        "gen": 3
       }
      }
     },
     "expect": {
      "status": 200,
      "json": {
       "token": {
        "$token": {
         "key": "alice",
         "gen": 3
        }
       },
       "gen": 3,
       "push": "$push"
      }
     }
    },
    {
     "request": {
      "route": "hello",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 2
      }
     },
     "expect": {
      "status": 401,
      "x_td_relay": "object",
      "json": {
       "error": "relay/token_stale"
      }
     }
    },
    {
     "request": {
      "route": "hello",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 3
      }
     },
     "expect": {
      "status": 200,
      "storage": {
       "devices": {
        "alice": {
         "gen": 3,
         "state": 1
        }
       }
      }
     }
    }
