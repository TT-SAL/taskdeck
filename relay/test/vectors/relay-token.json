  {
   "name": "a login makes every older token stale, and the login routes still take it",
   "clauses": [
    "RELAY-TOKEN-004",
    "RELAY-OBJ-003",
    "RELAY-LOGIN-004",
    "RELAY-TOKEN-005"
   ],
   "targets": [
    "core",
    "standby",
    "worker"
   ],
   "setup": {
    "keys": {
     "rec": {
      "seed": "406ea94d2a282f51b7bf75961b3f6f451ea521898ee8e4ecfa5497ff432136d9"
     },
     "rec2": {
      "seed": "601477a4d1e5778ea15d49216727e80cc794c8de6e4e04d6dd170ca9f7dac4a0"
     },
     "alice": {
      "seed": "d7258a3b7d43ca1cd07b61a0999872ff60e30b743b79ea1f48ace40b1606ab9d"
     },
     "bob": {
      "seed": "81efc1caf9812b36e07a48d5268e3b5bc48397197b4d5cb3008709576d42f990"
     },
     "carol": {
      "seed": "8eb214c69f0bdc5fcdeca36d04c75c7204020776f4ec9a3a30f84667d2f8599b"
     },
     "dave": {
      "seed": "b00c6eb651de49d9cdd12aaee777f98677c2845e459ee3e5f8e85e02429365c3"
     },
     "mallory": {
      "seed": "f5fda7279333a092f9774792b52ed8b7892e30e1e59c071aa702e4e734386d81"
     }
    },
    "boards": {
     "main": {
      "salt": "fc83dcf0bae23e1c430cd8ddc8418306",
      "recovery": "rec",
      "first": "alice"
     }
    }
   },
   "steps": [
    {
     "request": {
      "route": "login-nonce",
      "board": "main",
      "cred": {
       "door": true
      },
      "body": {
       "$dev": "alice"
      }
     },
     "expect": {
      "status": 200,
      "json": {
       "nonce": "$any",
       "gen": 2,
       "expires": {
        "$time": 120000
       }
      }
     }
    },
    {
     "request": {
      "route": "login",
      "board": "main",
      "cred": {
       "door": true
      },
      "body": {
       "$login": {
        "dev": "alice",
        "gen": 2
       }
      }
     },
     "expect": {
      "status": 200,
      "json": {
       "token": {
        "$token": {
         "key": "alice",
         "gen": 2
        }
       },
       "gen": 2,
       "push": "$push"
      }
     }
    },
    {
     "request": {
      "route": "hello",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 1
      }
     },
     "expect": {
      "status": 401,
      "x_td_relay": "object",
      "json": {
       "error": "relay/token_stale"
      }
     }
    },
    {
     "request": {
      "route": "read",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 1
      },
      "query": "after=0"
     },
     "expect": {
      "status": 401,
      "x_td_relay": "object",
      "json": {
       "error": "relay/token_stale"
      }
     }
    },
    {
     "request": {
      "route": "append",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 1
      },
      "body": {
       "$batch": [
        {
         "$frame": {
          "author": "alice",
          "ctr": 1
         }
        }
       ]
      }
     },
     "expect": {
      "status": 401,
      "x_td_relay": "object",
      "json": {
       "error": "relay/token_stale"
      },
      "rows_written": 0
     }
    },
    {
     "request": {
      "route": "hello",
      "board": "main",
      "cred": {
       "token": "alice",
       "gen": 3
      }
     },
     "expect": {
      "status": 401,
      "x_td_relay": "object",
      "json": {
       "error": "relay/token_stale"
      }
     }
    },
    {
